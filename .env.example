# Contact information shown across the website.
# Copy this file to `.env` (or `.env.local`) and edit the values.
# All variables MUST be prefixed with VITE_ to be exposed to the client by Vite.

# E.164 phone number used for all `tel:` links (no spaces).
VITE_CONTACT_PHONE=+918682927187

# Human-readable phone number shown to users.
VITE_CONTACT_PHONE_DISPLAY=+91 86829 27187

# Support / contact email address used for all `mailto:` links.
VITE_CONTACT_EMAIL=hello@thukal.in
